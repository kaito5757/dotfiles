#!/usr/bin/env bash
# Blocks commits whose staged changes contain secrets (gitleaks).
# Enabled by setup.sh via `git config core.hooksPath .githooks`.

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "✗ gitleaks が見つからないため、コミットを中止しました。" >&2
  echo "  brew install gitleaks を実行してから、もう一度コミットしてください。" >&2
  exit 1
fi

if ! gitleaks git --pre-commit --staged --redact --no-banner --verbose; then
  echo >&2
  echo "✗ 機密情報らしき内容が見つかったため、コミットを中止しました。" >&2
  echo "  該当箇所を取り除いてから、もう一度コミットしてください。" >&2
  exit 1
fi
